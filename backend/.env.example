# Base de datos PostgreSQL (por ejemplo Neon)
DATABASE_URL="postgresql://usuario:clave@host/basedatos?sslmode=require"

# Secreto para firmar la sesión (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto del backend y URL del frontend (para CORS)
PORT=4000
FRONTEND_URL="http://localhost:3000"

# Datos del administrador que crea `npm run seed`
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="una-clave-segura-de-10+-caracteres"
