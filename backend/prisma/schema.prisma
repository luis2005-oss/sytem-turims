generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  sesiones  Sesion[]
}

model Sesion {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}

model LoginIntento {
  id        Int      @id @default(autoincrement())
  email     String
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model CentroTuristico {
  id             Int      @id @default(autoincrement())
  nombre         String
  slug           String   @unique
  tipo           String
  zona           String?
  ubicacion      String
  descripcion    String   @db.Text
  imagenUrl      String?
  imagenPublicId String?
  publicado      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publicado])
  @@index([nombre])
}

model Receta {
  id                 Int      @id @default(autoincrement())
  nombre             String
  slug               String   @unique
  categoria          String
  descripcion        String   @db.Text
  tiempoPreparacion  String?
  porciones          Int?
  ingredientes       Json     @default("[]")
  preparacion        Json     @default("[]")
  imagenUrl          String?
  imagenPublicId     String?
  publicado          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([publicado])
  @@index([nombre])
}

model Fiesta {
  id             Int      @id @default(autoincrement())
  nombre         String
  slug           String   @unique
  fecha          String?
  lugar          String?
  descripcion    String   @db.Text
  imagenUrl      String?
  imagenPublicId String?
  publicado      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publicado])
  @@index([nombre])
}

model Historia {
  id             Int      @id @default(autoincrement())
  titulo         String
  slug           String   @unique
  categoria      String?
  resumen        String?  @db.Text
  contenido      String   @db.Text
  imagenUrl      String?
  imagenPublicId String?
  publicado      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([publicado])
  @@index([titulo])
}
